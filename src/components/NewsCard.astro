---
interface Props { entry: any; featured?: boolean; }
const { entry, featured = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}noticias/${entry.id}/`;
const date = entry.data.date.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });
---
<article class:list={['news-card', featured && 'featured-card']}>
  <a class="news-image" href={href} aria-label={`Leer ${entry.data.title}`}>
    {entry.data.image ? <img src={`${base}${entry.data.image.replace(/^\//, '')}`} alt="" loading={featured ? 'eager' : 'lazy'} /> : <span class="news-placeholder">ML</span>}
  </a>
  <div class="news-copy"><div class="news-meta"><span>{entry.data.category}</span><time datetime={entry.data.date.toISOString()}>{date}</time></div><h3><a href={href}>{entry.data.title}</a></h3><p>{entry.data.summary}</p>{entry.data.demo}</div>
</article>
