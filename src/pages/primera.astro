---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import LeagueTable from '../components/LeagueTable.astro';
import { getLeague } from '../lib/data';
const league = getLeague('primera');
---
<BaseLayout title="Primera Mouchos · Clasificación" description="Clasificación completa de Primera Mouchos por puntos fantasy acumulados.">
  <PageHero eyebrow="Temporada 2026/27" title="Primera Mouchos" intro="La máxima categoría. Diez equipos compiten por la puntuación fantasy total; los cuatro últimos descienden." stat="01" />
  <section class="container content-section">
    <div class="info-bar"><span><strong>Orden:</strong> puntos generales acumulados</span><span><strong>Sistema:</strong> Media AS + SofaScore</span><div class="legend"><span>Descenso (7.º–10.º)</span></div></div>
    <LeagueTable rows={league.standings} mode="relegation" />
    <p class="info-bar">“Jug.” es el campo original de la plataforma fantasy y se conserva de forma independiente; no representa necesariamente jornadas disputadas.</p>
  </section>
</BaseLayout>
